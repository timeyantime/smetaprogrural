{
  "name": "smetaprogrural",
  "version": "1.0.0",
  "description": "Сметная программа — веб-приложение для создания смет в строительстве",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .js,.ts",
    "lint:fix": "eslint src --ext .js,.ts --fix",
    "format": "prettier --write \"src/**/*.{js,ts,css,html}\"",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "serve": "python3 -m http.server 8080 --directory ."
  },
  "dependencies": {
    "alpinejs": "^3.14.9",
    "jsdom": "^29.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.2",
    "prettier": "^3.1.1",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "смета",
    "строительство",
    "расчет",
    "alpinejs"
  ],
  "author": "",
  "license": "MIT"
}
