{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    
    /* Linting */
    "strict": false, // плавный переход после миграции с JS: строгость включается по мере типизации
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": false,
    "noImplicitAny": false,

    /* Allow JS-style code migrated to TS (checkJs off — tsc не проверяет тела) */
    "checkJs": false,

    /* Module output for Vite dev server (import './x.ts' -> './x.js') */
    "verbatimModuleSyntax": false,
    "rewriteRelativeImportExtensions": true,
    "esModuleInterop": true,
    
    /* Path aliases */
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@/js/*": ["src/js/*"],
      "@/models/*": ["src/js/models/*"],
      "@/services/*": ["src/js/services/*"],
      "@/components/*": ["src/js/components/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"]
}
